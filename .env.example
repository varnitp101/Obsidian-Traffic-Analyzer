# PostgreSQL Database Configuration
POSTGRES_USER=accident_user
POSTGRES_PASSWORD=accident_secure_password
POSTGRES_DB=accident_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Apache Airflow Configuration
AIRFLOW_IMAGE_NAME=apache/airflow:2.8.1
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://accident_user:accident_secure_password@postgres:5432/accident_db

# MLflow Tracking Server Configuration
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BACKEND_STORE_URI=postgresql://accident_user:accident_secure_password@postgres:5432/accident_db
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts

# API & Dashboard Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://api:8000
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Open-Meteo Configuration
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive
GRID_CELL_SIZE_DEGREES=0.25
